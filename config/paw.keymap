#include <behaviors.dtsi>
#include <behaviors/unicode.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define KEYS_L 0 1 2 3 4 5   12 13 14 15 16 17   24 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23   30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41 42 43

&caps_word { continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>; };

&uc {
    default-mode = <UC_MODE_LINUX>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = < KEYS_R THUMBS>; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
            retro-tap;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = < KEYS_L THUMBS>; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
            retro-tap;
        };

        td_shift_caps: td_shift_capsword {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SHIFT_CAPSWORD";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHIFT>, <&caps_word>;
        };

        mtl: momentary_toggle_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_MO_TAP_TOG";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <15 16>;
        };

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <19 20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB         &kp Q              &kp W            &kp E            &kp R         &kp T          &kp Y      &kp U         &kp I                 &kp O                  &kp P                   &kp DELETE
&kp ESCAPE      &kp A              &kp S            &kp D            &kp F         &kp G          &kp H      &kp J         &kp K                 &kp L                  &kp SEMI                &kp ENTER
&td_shift_caps  &hml LEFT_SHIFT Z  &hml LEFT_ALT X  &hml LEFT_WIN C  &hml LCTRL V  &kp B          &kp N      &hmr RCTRL M  &hmr RIGHT_WIN COMMA  &hmr RIGHT_ALT PERIOD  &hmr RIGHT_SHIFT SLASH  &kp RIGHT_WIN
                                   &kp ENTER        &lt 3 SPACE      &mtl 2 1      &kp ENTER      &kp SPACE  &mo 3         &lt 5 BACKSPACE       &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        chinese_layer {
            label = "Chinese Layer";
            bindings = <
&trans  &kp GRAVE   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &uc 0xff0c 0  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &uc 0x3002 0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_0      &trans  &trans  &trans  &trans  &trans  &trans
                    &trans        &trans        &trans        &trans            &trans  &trans  &trans  &trans
            >;
        };

        number_layer {
            bindings = <
&trans          &kp PLUS      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS            &trans  &trans  &trans  &trans  &trans  &trans
&trans          &kp SLASH     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp EQUAL            &trans  &trans  &trans  &trans  &trans  &trans
&kp KP_NUMLOCK  &kp ASTERISK  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_0      &trans  &trans  &trans  &trans  &trans  &trans
                              &trans           &trans           &trans           &trans               &trans  &trans  &trans  &trans
            >;

            label = "Numbers Layer";
        };

        symbol_layer {
            bindings = <
&trans  &kp GRAVE        &kp QUESTION  &kp COLON         &kp MINUS          &kp PIPE           &kp CARET    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOLLAR        &kp BACKSLASH      &trans
&trans  &kp EXCLAMATION  &kp ASTERISK  &kp SLASH         &kp EQUAL          &kp AMPERSAND      &kp HASH     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON     &kp DOUBLE_QUOTES  &trans
&trans  &kp TILDE        &kp PLUS      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PERCENT        &kp AT_SIGN  &kp MINUS             &kp LESS_THAN          &kp GREATER_THAN  &kp SINGLE_QUOTE   &trans
                         &trans        &trans            &trans             &trans             &trans       &trans                &trans                 &trans
            >;

            label = "Symbols Layer";
        };

        navigation_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans    &trans         &trans       &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans  &trans
                &trans  &trans  &trans  &trans      &trans    &trans         &trans       &trans
            >;

            label = "Navigation Layer";
        };

        function_layer {
            bindings = <
&trans  &bt BT_SEL 4    &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0      &kp F12  &kp F7  &kp F8  &kp F9  &kp PRINTSCREEN  &trans
&trans  &trans          &trans        &trans        &trans        &bt BT_CLR        &kp F11  &kp F4  &kp F5  &kp F6  &kp INSERT       &trans
&trans  &studio_unlock  &uc UC_SET_WIN_COMPOSE    &uc UC_SET_LINUX    &out OUT_USB  &out OUT_BLE      &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK  &trans
                        &trans        &trans        &trans        &trans            &trans   &trans  &trans  &trans
            >;

            label = "Function Layer";
        };
    };
};
